{
  "name": "style-tuner",
  "version": "1.2.6",
  "description": "Fine-tune theme, snippet, and third-party CSS variables with configurable controls, plus a built-in markdown linter with 66 formatting rules.",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noemit",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src/**/*.ts --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "yarn prettier && yarn lint:fix",
    "bump": "node version-bump.mjs && git add manifest.json versions.json package.json",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "Sofqi",
  "license": "GPL-3.0",
  "devDependencies": {
    "@codemirror/view": "^6.38.6",
    "@trivago/prettier-plugin-sort-imports": "4.2.0",
    "@types/diff-match-patch": "^1.0.32",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.28.0",
    "eslint": "^8.57.1",
    "obsidian": "^1.13.0",
    "prettier": "3.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@simonwep/pickr": "https://github.com/nothingislost/pickr/archive/a17739f7aa1871b44da778cbb79ae76dae77d839.tar.gz",
    "@types/chroma-js": "^2.1.3",
    "@types/js-yaml": "^4.0.3",
    "chroma-js": "^2.1.2",
    "detect-indent": "^7.0.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^10.0.0",
    "fuzzysort": "^2.0.4",
    "js-yaml": "^4.1.0",
    "loglevel": "^1.9.2",
    "lru-cache": "^11.5.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "meaw": "^11.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "moment-parseformat": "^4.0.0",
    "ts-dedent": "^2.3.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
